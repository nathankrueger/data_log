[Unit]
Description=Gateway Server - LoRa receiver and dashboard poster
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 15
ExecStart=/bin/bash @REPO@/scripts/launch_gateway_server.sh
User=@USER@
WorkingDirectory=@REPO@
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
